{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spa.local/schema/grades.schema.json",
  "title": "Grade file",
  "description": "One set's card grades on the shared scale, 0.0 to 5.0 in steps of 0.5. One entry per card; no two entries share a setCode and collectorNumber (checked in code).",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "grades"],
  "properties": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setCode", "source", "provenance", "createdAt"],
      "properties": {
        "setCode": { "$ref": "#/$defs/setCode" },
        "source": { "enum": ["WIN_RATE", "MODEL"] },
        "provenance": {
          "description": "The dataset, or the model id, prompt version and date.",
          "type": "string",
          "pattern": "\\S"
        },
        "createdAt": {
          "description": "An ISO-8601 UTC instant.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "grades": {
      "type": "array",
      "items": { "$ref": "#/$defs/grade" }
    }
  },
  "$defs": {
    "setCode": {
      "type": "string",
      "pattern": "^[a-z0-9]{3,6}$"
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "collectorNumber", "setCode", "score", "confidence"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" },
        "collectorNumber": { "type": "string", "pattern": "\\S" },
        "setCode": { "$ref": "#/$defs/setCode" },
        "score": {
          "description": "0.0 to 5.0 in steps of 0.5. multipleOf applies only to non-integers because the validator's multipleOf rejects a whole number such as 3 written without a decimal point.",
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "if": { "type": "integer" },
          "else": { "multipleOf": 0.5 }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
